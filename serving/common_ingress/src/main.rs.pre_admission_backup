mod routes;

// COMET-Wasm V2: Common Rust Ingress
//
// Planned execution modes:
// 1. Embedded Wasmtime worker pool
// 2. Docker backend via internal HTTP
// 3. Native backend via an explicitly validated adapter
//
// Tenant routes are fixed at admission time.

use axum::{
    http::StatusCode,
    routing::get,
    Router,
};
use std::net::SocketAddr;

async fn noop() -> StatusCode {
    StatusCode::NO_CONTENT
}

async fn health() -> &'static str {
    "ok"
}

#[tokio::main]
async fn main() -> anyhow::Result<()> {
    let routes_path = std::env::args()
        .nth(1)
        .unwrap_or_else(|| {
            "research_enhancement/routes.example.json".to_string()
        });

    let routes = routes::load_routes(&routes_path)?;

    println!(
        "Loaded {} admitted tenant routes from {}",
        routes.len(),
        routes_path
    );

    let app = Router::new()
        .route("/health", get(health))
        .route("/noop", get(noop));

    let addr = SocketAddr::from(([127, 0, 0, 1], 8200));
    let listener = tokio::net::TcpListener::bind(addr).await?;

    println!("COMET-Wasm V2 common ingress listening on {addr}");
    axum::serve(listener, app).await?;

    Ok(())
}

#[cfg(test)]
mod tests {
    use super::*;

    #[tokio::test]
    async fn noop_returns_204() {
        assert_eq!(noop().await, StatusCode::NO_CONTENT);
    }

    #[tokio::test]
    async fn health_returns_ok() {
        assert_eq!(health().await, "ok");
    }
}
